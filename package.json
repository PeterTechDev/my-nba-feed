{
  "name": "my-nba-feed",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:ssr": "node --experimental-strip-types --test tests/morning-briefing-ssr.e2e.mjs",
    "test:e2e": "playwright test",
    "highlights:sync": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-youtube-highlights.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "lucide-react": "^0.564.0",
    "next": "^16.4.3",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "^4.6.6",
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    }
  }
}
